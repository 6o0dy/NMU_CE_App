<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="BgMain">#050B14</Color>
    <Color x:Key="BgCard">#1E293B</Color>
    <Color x:Key="Primary">#00F2FF</Color>
    <Color x:Key="Accent">#BD00FF</Color>
    <Color x:Key="Danger">#FF4757</Color>
    <Color x:Key="TextPrimary">#E2E8F0</Color>
    <Color x:Key="TextSecondary">#94A3B8</Color>
    <Color x:Key="StarColor">#FFB800</Color>
    <Color x:Key="GridColor">#0D00F2FF</Color>
    <Color x:Key="BorderColor">#334155</Color>
    <Color x:Key="InputBg">#0F172A</Color>
    <Color x:Key="HeaderBg">#4D050B14</Color>
    <Color x:Key="ModalOverlay">#FA050B14</Color>
    <Color x:Key="TimerColor">#FF9F43</Color>

    <Color x:Key="PrimaryDark">#00C4CC</Color>
    <Color x:Key="NeonRed">#FF0055</Color>
    <Color x:Key="NeonGreen">#00FF88</Color>
    <Color x:Key="NeonPurple">#BD00FF</Color>
    <Color x:Key="NeonOrange">#FF6600</Color>
    <Color x:Key="NeonPink">#FF00AA</Color>
    <Color x:Key="NeonYellow">#FFDD00</Color>
    <Color x:Key="GlowCyan">#0D00F2FF</Color>
    <Color x:Key="GlowRed">#0DFF0055</Color>
    <Color x:Key="GlowGreen">#0D00FF88</Color>
    <Color x:Key="GlowPurple">#0DBD00FF</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="BgMainBrush" Color="{StaticResource BgMain}"/>

</ResourceDictionary>
