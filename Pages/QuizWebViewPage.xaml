<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NMU_CE_App.Controls"
             x:Class="NMU_CE_App.Pages.QuizWebViewPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BgMain}">

    <Grid RowDefinitions="Auto, *">
        <controls:AITitleBar x:Name="PageTitleBar"
                             Grid.Row="0"
                             Title="Tests"
                             ShowBack="True"
                             BackClicked="OnTitleBarBack" />

        <Grid Grid.Row="1" RowDefinitions="*, Auto">
            <WebView x:Name="QuizWebView"
                     Grid.Row="0"
                     VerticalOptions="Fill"
                     HorizontalOptions="Fill"
                     BackgroundColor="{StaticResource BgMain}" />

            <Grid x:Name="LoadingOverlay"
                  Grid.RowSpan="2"
                  BackgroundColor="{StaticResource ModalOverlay}"
                  IsVisible="True">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                    <ActivityIndicator IsRunning="True"
                                        Color="{StaticResource AIPrimary}"
                                        WidthRequest="40" HeightRequest="40" />
                    <Label x:Name="LoadingLabel"
                           Text="Starting..."
                           FontSize="16"
                           FontFamily="Cairo"
                           TextColor="{StaticResource AICyan}"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="CacheSummaryLabel"
                           Text=""
                           FontSize="12"
                           FontFamily="Cairo"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalTextAlignment="Center"
                           IsVisible="False" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
