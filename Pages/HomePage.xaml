<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NMU_CE_App.Controls"
             x:Class="NMU_CE_App.Pages.HomePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BgMain}">

    <Grid RowDefinitions="Auto, *">
        <GraphicsView x:Name="GridCanvas"
                      InputTransparent="True"
                      Grid.RowSpan="2">
            <GraphicsView.Drawable>
                <controls:GridBackgroundDrawable />
            </GraphicsView.Drawable>
        </GraphicsView>

        <controls:AITitleBar x:Name="PageTitleBar"
                             Grid.Row="0"
                             Title="NMU-CE &amp; AIE"
                             ShowBack="False" />

        <ScrollView x:Name="ContentScroller"
                    Grid.Row="1"
                    Padding="20,10">
            <VerticalStackLayout x:Name="HomeContent"
                                 MaximumWidthRequest="1280"
                                 Spacing="0"
                                 HorizontalOptions="Center">

                <!-- Hero Section -->
                <HorizontalStackLayout HorizontalOptions="Center"
                                       Spacing="10"
                                       Margin="0,28,0,0">
                    <Label Text="🚀"
                           FontSize="24"
                           VerticalTextAlignment="Center" />
                    <Label x:Name="UserNameLabel"
                           Text="Future Engineer"
                           FontSize="26"
                           TextColor="{StaticResource AICyan}"
                           FontAttributes="Bold"
                           FontFamily="Cairo"
                           VerticalTextAlignment="Center" />
                    <Label Text="مرحباً بك يا"
                           FontSize="22"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontFamily="Cairo"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <Label Text="&lt; Everything you need is here /&gt;"
                       FontSize="14"
                       TextColor="{StaticResource TextSecondary}"
                       FontFamily="Cairo"
                       HorizontalTextAlignment="Center"
                       Margin="0,8,0,32" />

                <Grid x:Name="CardsGrid"
                      ColumnDefinitions="*, *"
                      RowDefinitions="Auto, Auto, Auto"
                      ColumnSpacing="28"
                      RowSpacing="28">

                    <!-- Materials Card -->
                    <Border Grid.ColumnSpan="2"
                            x:Name="CardMaterials"
                            BackgroundColor="{StaticResource BgCard}"
                            Stroke="{StaticResource AIPrimary}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 22"
                            Padding="28,24"
                            Margin="4">
                        <Border.Shadow>
                            <Shadow x:Name="MatShadow" Brush="#557C3AED" Offset="0,0" Radius="28" Opacity="0.5" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="materials" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="22">
                            <Border Grid.Column="0"
                                    x:Name="MatIconContainer"
                                    WidthRequest="62" HeightRequest="62"
                                    BackgroundColor="#157C3AED"
                                    Stroke="{StaticResource AIPrimary}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 31"
                                    VerticalOptions="Center">
                                <Border.Shadow>
                                    <Shadow Brush="#557C3AED" Offset="0,0" Radius="16" Opacity="0.5" />
                                </Border.Shadow>
                                <Label Text="🧠" FontSize="30" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                                <Label Text="Study Materials"
                                       TextColor="White"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       FontFamily="Cairo" />
                                <Label Text="Structure Programming, Mechanics..."
                                       TextColor="{StaticResource TextSecondary}"
                                       FontSize="13"
                                       FontFamily="Cairo" />
                                <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                                    <Label Text="→" TextColor="{StaticResource AIPrimary}" FontSize="13" VerticalTextAlignment="Center" FontAttributes="Bold" />
                                    <Label Text="Browse subjects" TextColor="{StaticResource AIPrimary}" FontSize="13" FontFamily="Cairo" VerticalTextAlignment="Center" FontAttributes="Bold" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- YouTube Card -->
                    <Border Grid.Row="1" Grid.Column="0"
                            x:Name="CardYoutube"
                            BackgroundColor="{StaticResource BgCard}"
                            Stroke="{StaticResource NeuralRed}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 20"
                            Padding="16"
                            Margin="4">
                        <Border.Shadow>
                            <Shadow x:Name="YtShadow" Brush="#33FF0055" Offset="0,0" Radius="24" Opacity="0.35" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="youtube" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                            <Border x:Name="YtIconContainer"
                                    Grid.Column="0"
                                    WidthRequest="46" HeightRequest="46"
                                    BackgroundColor="#15FF0055"
                                    Stroke="{StaticResource NeuralRed}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 23"
                                    VerticalOptions="Center">
                                <Border.Shadow>
                                    <Shadow Brush="#33FF0055" Offset="0,0" Radius="12" Opacity="0.5" />
                                </Border.Shadow>
                                <Label Text="🤖" FontSize="22" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="YouTube" TextColor="White" FontSize="15" FontAttributes="Bold" FontFamily="Cairo" />
                                <Label Text="Explanations From YouTube" TextColor="{StaticResource TextSecondary}" FontSize="11" FontFamily="Cairo" LineBreakMode="TailTruncation" MaxLines="1" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Recorded Card -->
                    <Border Grid.Row="1" Grid.Column="1"
                            x:Name="CardRecorded"
                            BackgroundColor="{StaticResource BgCard}"
                            Stroke="{StaticResource NeuralPurple}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 20"
                            Padding="16"
                            Margin="4">
                        <Border.Shadow>
                            <Shadow x:Name="RecShadow" Brush="#33BD00FF" Offset="0,0" Radius="24" Opacity="0.35" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="recorded" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                            <Border x:Name="RecIconContainer"
                                    Grid.Column="0"
                                    WidthRequest="46" HeightRequest="46"
                                    BackgroundColor="#15BD00FF"
                                    Stroke="{StaticResource NeuralPurple}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 23"
                                    VerticalOptions="Center">
                                <Border.Shadow>
                                    <Shadow Brush="#33BD00FF" Offset="0,0" Radius="12" Opacity="0.5" />
                                </Border.Shadow>
                                <Label Text="💾" FontSize="22" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="Recorded" TextColor="White" FontSize="15" FontAttributes="Bold" FontFamily="Cairo" />
                                <Label Text="Videos &amp; Audio Recordings" TextColor="{StaticResource TextSecondary}" FontSize="11" FontFamily="Cairo" LineBreakMode="TailTruncation" MaxLines="1" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Tests Card -->
                    <Border Grid.Row="2" Grid.Column="0"
                            x:Name="CardTests"
                            BackgroundColor="{StaticResource BgCard}"
                            Stroke="{StaticResource NeuralOrange}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 20"
                            Padding="16"
                            Margin="4">
                        <Border.Shadow>
                            <Shadow x:Name="TestShadow" Brush="#33FF6600" Offset="0,0" Radius="24" Opacity="0.35" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="tests" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                            <Border x:Name="TestIconContainer"
                                    Grid.Column="0"
                                    WidthRequest="46" HeightRequest="46"
                                    BackgroundColor="#15FF6600"
                                    Stroke="{StaticResource NeuralOrange}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 23"
                                    VerticalOptions="Center">
                                <Border.Shadow>
                                    <Shadow Brush="#33FF6600" Offset="0,0" Radius="12" Opacity="0.5" />
                                </Border.Shadow>
                                <Label Text="📋" FontSize="22" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="Tests" TextColor="White" FontSize="15" FontAttributes="Bold" FontFamily="Cairo" />
                                <Label Text="Test Your Skills" TextColor="{StaticResource TextSecondary}" FontSize="11" FontFamily="Cairo" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Laboratory Card -->
                    <Border Grid.Row="2" Grid.Column="1"
                            x:Name="CardLab"
                            BackgroundColor="{StaticResource BgCard}"
                            Stroke="{StaticResource AIGreen}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 20"
                            Padding="16"
                            Margin="4">
                        <Border.Shadow>
                            <Shadow x:Name="LabShadow" Brush="#3306D6A0" Offset="0,0" Radius="24" Opacity="0.35" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="laboratory" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                            <Border x:Name="LabIconContainer"
                                    Grid.Column="0"
                                    WidthRequest="46" HeightRequest="46"
                                    BackgroundColor="#1506D6A0"
                                    Stroke="{StaticResource AIGreen}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 23"
                                    VerticalOptions="Center">
                                <Border.Shadow>
                                    <Shadow Brush="#3306D6A0" Offset="0,0" Radius="12" Opacity="0.5" />
                                </Border.Shadow>
                                <Label Text="🔌" FontSize="22" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="Laboratory" TextColor="White" FontSize="15" FontAttributes="Bold" FontFamily="Cairo" />
                                <Label Text="Practical Experiments" TextColor="{StaticResource TextSecondary}" FontSize="11" FontFamily="Cairo" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <BoxView HeightRequest="100" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- FAB Backdrop -->
        <BoxView x:Name="FabBackdrop"
                 Grid.Row="1"
                 IsVisible="False"
                 Color="#66000000"
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFabBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- FAB Items -->
        <HorizontalStackLayout x:Name="FabItemWhatsApp"
                               Grid.Row="1"
                               IsVisible="False"
                               Opacity="0"
                               VerticalOptions="End" HorizontalOptions="End"
                               Margin="0,0,24,56" Spacing="14">
            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnWhatsAppTapped" />
            </HorizontalStackLayout.GestureRecognizers>
            <Border BackgroundColor="#CC0A0A1A"
                    Stroke="#337C3AED"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="14,8"
                    VerticalOptions="Center">
                <Label Text="WhatsApp"
                       TextColor="White"
                       FontSize="13"
                       FontFamily="Cairo"
                       FontAttributes="Bold" />
            </Border>
            <Border BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource AIGreen}"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20"
                    WidthRequest="40" HeightRequest="40">
                <Border.Shadow>
                    <Shadow Brush="#3306D6A0" Offset="0,0" Radius="10" Opacity="0.4" />
                </Border.Shadow>
                <Label Text="💬"
                       FontSize="18"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Border>
        </HorizontalStackLayout>

        <HorizontalStackLayout x:Name="FabItemEval"
                               Grid.Row="1"
                               IsVisible="False"
                               Opacity="0"
                               VerticalOptions="End" HorizontalOptions="End"
                               Margin="0,0,24,56" Spacing="14">
            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnEvalTapped" />
            </HorizontalStackLayout.GestureRecognizers>
            <Border BackgroundColor="#CC0A0A1A"
                    Stroke="#337C3AED"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="14,8"
                    VerticalOptions="Center">
                <Label Text="Evaluation"
                       TextColor="White"
                       FontSize="13"
                       FontFamily="Cairo"
                       FontAttributes="Bold" />
            </Border>
            <Border BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource NeuralYellow}"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20"
                    WidthRequest="40" HeightRequest="40">
                <Border.Shadow>
                    <Shadow Brush="#33FFDD00" Offset="0,0" Radius="10" Opacity="0.4" />
                </Border.Shadow>
                <Label Text="★"
                       FontSize="18"
                       TextColor="#FFB800"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Border>
        </HorizontalStackLayout>

        <HorizontalStackLayout x:Name="FabItemData"
                               Grid.Row="1"
                               IsVisible="False"
                               Opacity="0"
                               VerticalOptions="End" HorizontalOptions="End"
                               Margin="0,0,24,56" Spacing="14">
            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnManageDataTapped" />
            </HorizontalStackLayout.GestureRecognizers>
            <Border BackgroundColor="#CC0A0A1A"
                    Stroke="#337C3AED"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="14,8"
                    VerticalOptions="Center">
                <Label Text="My Data"
                       TextColor="White"
                       FontSize="13"
                       FontFamily="Cairo"
                       FontAttributes="Bold" />
            </Border>
            <Border BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource AIPrimary}"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20"
                    WidthRequest="40" HeightRequest="40">
                <Border.Shadow>
                    <Shadow Brush="#337C3AED" Offset="0,0" Radius="10" Opacity="0.4" />
                </Border.Shadow>
                <Label Text="👤"
                       FontSize="18"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Border>
        </HorizontalStackLayout>

        <!-- FAB Main -->
        <Border x:Name="FabMain"
                Grid.Row="1"
                BackgroundColor="{StaticResource AIPrimary}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 28"
                WidthRequest="56" HeightRequest="56"
                VerticalOptions="End" HorizontalOptions="End"
                Margin="0,0,20,60">
            <Border.Shadow>
                <Shadow Brush="#667C3AED"
                        Offset="0,4"
                        Radius="16"
                        Opacity="0.6" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFabTapped" />
            </Border.GestureRecognizers>
            <Border BackgroundColor="#1AFFFFFF"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    WidthRequest="44" HeightRequest="44"
                    VerticalOptions="Center" HorizontalOptions="Center">
                <Label x:Name="FabIcon"
                       Text="+"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Border>
        </Border>

        <!-- Manage Data Modal -->
        <Grid x:Name="ManageOverlay"
              Grid.Row="1"
              IsVisible="False"
              BackgroundColor="{StaticResource ModalOverlay}">
            <Border BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource AIPrimary}"
                    StrokeThickness="3"
                    StrokeShape="RoundRectangle 25"
                    MaximumWidthRequest="450"
                    WidthRequest="{OnIdiom Phone='340', Tablet='420', Desktop='450'}"
                    Padding="{OnIdiom Phone='24,32', Desktop='32,40'}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="20,0">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="YOUR INFORMATION"
                               TextColor="White"
                               FontSize="18"
                               FontAttributes="Bold"
                               FontFamily="Cairo"
                               VerticalTextAlignment="Center" />
                        <Label Grid.Column="1"
                               Text="×"
                               FontSize="26"
                               TextColor="{StaticResource AICyan}"
                               VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseModalTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Your Name" TextColor="{StaticResource AICyan}" FontSize="13" FontAttributes="Bold" FontFamily="Cairo" />
                        <Border BackgroundColor="{StaticResource InputBg}" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="0">
                            <Entry x:Name="EditName" IsEnabled="False" TextColor="White" FontFamily="Cairo" FontSize="14" BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Academic Level" TextColor="{StaticResource AICyan}" FontSize="13" FontAttributes="Bold" FontFamily="Cairo" />
                        <Border BackgroundColor="{StaticResource InputBg}" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="0">
                            <Picker x:Name="EditYear" IsEnabled="False" TextColor="White" FontFamily="Cairo" FontSize="14" BackgroundColor="Transparent">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Level 1</x:String>
                                        <x:String>Level 2</x:String>
                                        <x:String>Level 3</x:String>
                                        <x:String>Level 4</x:String>
                                        <x:String>Level 5</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="The Semester" TextColor="{StaticResource AICyan}" FontSize="13" FontAttributes="Bold" FontFamily="Cairo" />
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Border x:Name="EditTerm1" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12" BackgroundColor="{StaticResource InputBg}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEditTerm1Tapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="EditTerm1Label" Text="Semester 1" TextColor="{StaticResource TextSecondary}" FontFamily="Cairo" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" x:Name="EditTerm2" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12" BackgroundColor="{StaticResource InputBg}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEditTerm2Tapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="EditTerm2Label" Text="Semester 2" TextColor="{StaticResource TextSecondary}" FontFamily="Cairo" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="20,8,20,0">
                        <Border x:Name="EditSaveBtn" BackgroundColor="{StaticResource AIPrimary}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="0" HeightRequest="44">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEditSaveTapped" />
                            </Border.GestureRecognizers>
                            <Label x:Name="EditSaveLabel" Text="Change" TextColor="White" FontFamily="Cairo" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="Transparent" Stroke="#FF4757" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="0" HeightRequest="44">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDeleteTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="Delete Data" TextColor="#FF4757" FontFamily="Cairo" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
