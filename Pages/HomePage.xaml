<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NMU_CE_App.Controls"
             x:Class="NMU_CE_App.Pages.HomePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BgMain}">

    <Grid>
        <GraphicsView x:Name="GridCanvas"
                      InputTransparent="True">
            <GraphicsView.Drawable>
                <controls:GridBackgroundDrawable />
            </GraphicsView.Drawable>
        </GraphicsView>

        <Grid RowDefinitions="Auto, *">
            <Grid Grid.Row="0"
                  BackgroundColor="{StaticResource HeaderBg}"
                  Padding="20,0"
                  ColumnDefinitions="Auto, *, Auto"
                  HeightRequest="58">

                <Border Grid.Column="0"
                        BackgroundColor="#0DFFFFFF"
                        Stroke="#1FFFFFFF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="4"
                        WidthRequest="34" HeightRequest="34"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInfoTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="ⓘ"
                           FontSize="16"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>

                <HorizontalStackLayout Grid.Column="1"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Spacing="0">
                    <Label Text="NMU"
                           TextColor="White"
                           FontSize="20"
                           FontAttributes="Bold"
                           FontFamily="Cairo"
                           VerticalTextAlignment="Center" />
                    <Label Text="-CE &amp; AIE"
                           TextColor="{StaticResource Primary}"
                           FontSize="20"
                           FontAttributes="Bold"
                           FontFamily="Cairo"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <Border Grid.Column="2"
                        BackgroundColor="#0D00F2FF"
                        Stroke="#3300F2FF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="4"
                        WidthRequest="34" HeightRequest="34"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFullscreenTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="FullscreenIcon"
                           Text="⛶"
                           FontSize="14"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>
            </Grid>

            <ScrollView Grid.Row="1"
                        x:Name="ContentScroller"
                        Padding="20,10">
                <Grid HorizontalOptions="Center">
                    <VerticalStackLayout x:Name="HomeContent"
                                         MaximumWidthRequest="1280"
                                         Spacing="0">

                    <HorizontalStackLayout HorizontalOptions="Center"
                                           Spacing="10"
                                           Margin="0,28,0,0">
                        <Label Text="🚀"
                               FontSize="24"
                               VerticalTextAlignment="Center" />
                        <Label x:Name="UserNameLabel"
                               Text="Future Engineer"
                               FontSize="26"
                               TextColor="{StaticResource Primary}"
                               FontAttributes="Bold"
                               FontFamily="Cairo"
                               VerticalTextAlignment="Center" />
                        <Label Text="مرحباً بك يا"
                               FontSize="22"
                               TextColor="White"
                               FontAttributes="Bold"
                               FontFamily="Cairo"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>

                    <Label Text="&lt; Everything you need is here /&gt;"
                           FontSize="14"
                           TextColor="{StaticResource TextSecondary}"
                           FontFamily="Cairo"
                           HorizontalTextAlignment="Center"
                           Margin="0,8,0,32" />

                    <Grid x:Name="CardsGrid"
                          ColumnDefinitions="*, *"
                          RowDefinitions="Auto, Auto, Auto"
                          ColumnSpacing="28"
                          RowSpacing="28">
                        <Border Grid.ColumnSpan="2"
                                x:Name="CardMaterials"
                                BackgroundColor="#1A1E293B"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 22"
                                Padding="28,24"
                                Margin="4">
                            <Border.Shadow>
                                <Shadow x:Name="MatShadow" Brush="#5500F2FF" Offset="0,0" Radius="28" Opacity="0.5" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="materials" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="22">
                                <Border Grid.Column="0"
                                        x:Name="MatIconContainer"
                                        WidthRequest="62" HeightRequest="62"
                                        BackgroundColor="#1500F2FF"
                                        Stroke="{StaticResource Primary}"
                                        StrokeThickness="1.5"
                                        StrokeShape="RoundRectangle 31"
                                        VerticalOptions="Center">
                                    <Border.Shadow>
                                        <Shadow Brush="#5500F2FF" Offset="0,0" Radius="16" Opacity="0.5" />
                                    </Border.Shadow>
                                    <Label Text="🧠" FontSize="30" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                                    <Label Text="Study Materials"
                                           TextColor="White"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           FontFamily="Cairo" />
                                    <Label Text="Structure Programming, Mechanics..."
                                           TextColor="{StaticResource TextSecondary}"
                                           FontSize="13"
                                           FontFamily="Cairo" />
                                    <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                                        <Label Text="→" TextColor="{StaticResource Primary}" FontSize="13" VerticalTextAlignment="Center" FontAttributes="Bold" />
                                        <Label Text="Browse subjects" TextColor="{StaticResource Primary}" FontSize="13" FontFamily="Cairo" VerticalTextAlignment="Center" FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0"
                                x:Name="CardYoutube"
                                BackgroundColor="#1A1E293B"
                                Stroke="{StaticResource NeonRed}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 20"
                                Padding="16"
                                Margin="4">
                            <Border.Shadow>
                                <Shadow x:Name="YtShadow" Brush="#33FF0055" Offset="0,0" Radius="24" Opacity="0.35" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="youtube" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                                <Border x:Name="YtIconContainer"
                                        Grid.Column="0"
                                        WidthRequest="46" HeightRequest="46"
                                        BackgroundColor="#15FF0055"
                                        Stroke="{StaticResource NeonRed}"
                                        StrokeThickness="1.5"
                                        StrokeShape="RoundRectangle 23"
                                        VerticalOptions="Center">
                                    <Border.Shadow>
                                        <Shadow Brush="#33FF0055" Offset="0,0" Radius="12" Opacity="0.5" />
                                    </Border.Shadow>
                                    <Label Text="🤖" FontSize="22" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                    <Label Text="YouTube" TextColor="White" FontSize="15" FontAttributes="Bold" FontFamily="Cairo" />
                                    <Label Text="Explanations From YouTube" TextColor="{StaticResource TextSecondary}" FontSize="11" FontFamily="Cairo" LineBreakMode="TailTruncation" MaxLines="1" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1"
                                x:Name="CardRecorded"
                                BackgroundColor="#1A1E293B"
                                Stroke="{StaticResource NeonPurple}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 20"
                                Padding="16"
                                Margin="4">
                            <Border.Shadow>
                                <Shadow x:Name="RecShadow" Brush="#33BD00FF" Offset="0,0" Radius="24" Opacity="0.35" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="recorded" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                                <Border x:Name="RecIconContainer"
                                        Grid.Column="0"
                                        WidthRequest="46" HeightRequest="46"
                                        BackgroundColor="#15BD00FF"
                                        Stroke="{StaticResource NeonPurple}"
                                        StrokeThickness="1.5"
                                        StrokeShape="RoundRectangle 23"
                                        VerticalOptions="Center">
                                    <Border.Shadow>
                                        <Shadow Brush="#33BD00FF" Offset="0,0" Radius="12" Opacity="0.5" />
                                    </Border.Shadow>
                                    <Label Text="💾" FontSize="22" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                    <Label Text="Recorded" TextColor="White" FontSize="15" FontAttributes="Bold" FontFamily="Cairo" />
                                    <Label Text="Videos &amp; Audio Recordings" TextColor="{StaticResource TextSecondary}" FontSize="11" FontFamily="Cairo" LineBreakMode="TailTruncation" MaxLines="1" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0"
                                x:Name="CardTests"
                                BackgroundColor="#1A1E293B"
                                Stroke="{StaticResource NeonOrange}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 20"
                                Padding="16"
                                Margin="4">
                            <Border.Shadow>
                                <Shadow x:Name="TestShadow" Brush="#33FF6600" Offset="0,0" Radius="24" Opacity="0.35" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="tests" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                                <Border x:Name="TestIconContainer"
                                        Grid.Column="0"
                                        WidthRequest="46" HeightRequest="46"
                                        BackgroundColor="#15FF6600"
                                        Stroke="{StaticResource NeonOrange}"
                                        StrokeThickness="1.5"
                                        StrokeShape="RoundRectangle 23"
                                        VerticalOptions="Center">
                                    <Border.Shadow>
                                        <Shadow Brush="#33FF6600" Offset="0,0" Radius="12" Opacity="0.5" />
                                    </Border.Shadow>
                                    <Label Text="📋" FontSize="22" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                    <Label Text="Tests" TextColor="White" FontSize="15" FontAttributes="Bold" FontFamily="Cairo" />
                                    <Label Text="Test Your Skills" TextColor="{StaticResource TextSecondary}" FontSize="11" FontFamily="Cairo" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="1"
                                x:Name="CardLab"
                                BackgroundColor="#1A1E293B"
                                Stroke="{StaticResource NeonGreen}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 20"
                                Padding="16"
                                Margin="4">
                            <Border.Shadow>
                                <Shadow x:Name="LabShadow" Brush="#3300FF88" Offset="0,0" Radius="24" Opacity="0.35" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="laboratory" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                                <Border x:Name="LabIconContainer"
                                        Grid.Column="0"
                                        WidthRequest="46" HeightRequest="46"
                                        BackgroundColor="#1500FF88"
                                        Stroke="{StaticResource NeonGreen}"
                                        StrokeThickness="1.5"
                                        StrokeShape="RoundRectangle 23"
                                        VerticalOptions="Center">
                                    <Border.Shadow>
                                        <Shadow Brush="#3300FF88" Offset="0,0" Radius="12" Opacity="0.5" />
                                    </Border.Shadow>
                                    <Label Text="🔌" FontSize="22" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                    <Label Text="Laboratory" TextColor="White" FontSize="15" FontAttributes="Bold" FontFamily="Cairo" />
                                    <Label Text="Practical Experiments" TextColor="{StaticResource TextSecondary}" FontSize="11" FontFamily="Cairo" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="100" Color="Transparent" />
                </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </Grid>

        <BoxView x:Name="FabBackdrop"
                 IsVisible="False"
                 Color="#66000000"
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFabBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <HorizontalStackLayout x:Name="FabItemWhatsApp"
                               IsVisible="False"
                               Opacity="0"
                               VerticalOptions="End" HorizontalOptions="End"
                               Margin="0,0,24,56" Spacing="14">
            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnWhatsAppTapped" />
            </HorizontalStackLayout.GestureRecognizers>
            <Border BackgroundColor="#CC0F172A"
                    Stroke="#3300F2FF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="14,8"
                    VerticalOptions="Center">
                <Label Text="WhatsApp"
                       TextColor="White"
                       FontSize="13"
                       FontFamily="Cairo"
                       FontAttributes="Bold" />
            </Border>
            <Border BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource NeonGreen}"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20"
                    WidthRequest="40" HeightRequest="40">
                <Border.Shadow>
                    <Shadow Brush="#3300FF88" Offset="0,0" Radius="10" Opacity="0.4" />
                </Border.Shadow>
                <Label Text="💬"
                       FontSize="18"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Border>
        </HorizontalStackLayout>

        <HorizontalStackLayout x:Name="FabItemEval"
                               IsVisible="False"
                               Opacity="0"
                               VerticalOptions="End" HorizontalOptions="End"
                               Margin="0,0,24,56" Spacing="14">
            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnEvalTapped" />
            </HorizontalStackLayout.GestureRecognizers>
            <Border BackgroundColor="#CC0F172A"
                    Stroke="#3300F2FF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="14,8"
                    VerticalOptions="Center">
                <Label Text="Evaluation"
                       TextColor="White"
                       FontSize="13"
                       FontFamily="Cairo"
                       FontAttributes="Bold" />
            </Border>
            <Border BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource NeonYellow}"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20"
                    WidthRequest="40" HeightRequest="40">
                <Border.Shadow>
                    <Shadow Brush="#33FFDD00" Offset="0,0" Radius="10" Opacity="0.4" />
                </Border.Shadow>
                <Label Text="★"
                       FontSize="18"
                       TextColor="#FFB800"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Border>
        </HorizontalStackLayout>

        <HorizontalStackLayout x:Name="FabItemData"
                               IsVisible="False"
                               Opacity="0"
                               VerticalOptions="End" HorizontalOptions="End"
                               Margin="0,0,24,56" Spacing="14">
            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnManageDataTapped" />
            </HorizontalStackLayout.GestureRecognizers>
            <Border BackgroundColor="#CC0F172A"
                    Stroke="#3300F2FF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="14,8"
                    VerticalOptions="Center">
                <Label Text="My Data"
                       TextColor="White"
                       FontSize="13"
                       FontFamily="Cairo"
                       FontAttributes="Bold" />
            </Border>
            <Border BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource NeonPurple}"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20"
                    WidthRequest="40" HeightRequest="40">
                <Border.Shadow>
                    <Shadow Brush="#33BD00FF" Offset="0,0" Radius="10" Opacity="0.4" />
                </Border.Shadow>
                <Label Text="👤"
                       FontSize="18"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Border>
        </HorizontalStackLayout>

        <Border x:Name="FabMain"
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 28"
                WidthRequest="56" HeightRequest="56"
                VerticalOptions="End" HorizontalOptions="End"
                Margin="0,0,20,60">
            <Border.Shadow>
                <Shadow Brush="#6600F2FF"
                        Offset="0,4"
                        Radius="16"
                        Opacity="0.6" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFabTapped" />
            </Border.GestureRecognizers>
            <Border BackgroundColor="#1A050B14"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    WidthRequest="44" HeightRequest="44"
                    VerticalOptions="Center" HorizontalOptions="Center">
                <Label x:Name="FabIcon"
                       Text="+"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#050B14"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Border>
        </Border>

        <Grid x:Name="ManageOverlay"
              IsVisible="False"
              BackgroundColor="{StaticResource ModalOverlay}">
            <Border BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource Primary}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 25"
                    Padding="28"
                    MaximumWidthRequest="420"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="20,0">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="YOUR INFORMATION"
                               TextColor="White"
                               FontSize="18"
                               FontAttributes="Bold"
                               FontFamily="Cairo"
                               VerticalTextAlignment="Center" />
                        <Label Grid.Column="1"
                               Text="×"
                               FontSize="26"
                               TextColor="{StaticResource Primary}"
                               VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseModalTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Your Name" TextColor="{StaticResource Primary}" FontSize="13" FontAttributes="Bold" FontFamily="Cairo" />
                        <Border BackgroundColor="{StaticResource InputBg}" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,0">
                            <Entry x:Name="EditName" IsEnabled="False" TextColor="White" FontFamily="Cairo" FontSize="14" BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Academic Level" TextColor="{StaticResource Primary}" FontSize="13" FontAttributes="Bold" FontFamily="Cairo" />
                        <Border BackgroundColor="{StaticResource InputBg}" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,0">
                            <Picker x:Name="EditYear" IsEnabled="False" TextColor="White" FontFamily="Cairo" FontSize="14" BackgroundColor="Transparent">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Level 1</x:String>
                                        <x:String>Level 2</x:String>
                                        <x:String>Level 3</x:String>
                                        <x:String>Level 4</x:String>
                                        <x:String>Level 5</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="The Semester" TextColor="{StaticResource Primary}" FontSize="13" FontAttributes="Bold" FontFamily="Cairo" />
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Border x:Name="EditTerm1" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12" BackgroundColor="{StaticResource InputBg}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEditTerm1Tapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="EditTerm1Label" Text="Semester 1" TextColor="{StaticResource TextSecondary}" FontFamily="Cairo" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" x:Name="EditTerm2" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12" BackgroundColor="{StaticResource InputBg}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEditTerm2Tapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="EditTerm2Label" Text="Semester 2" TextColor="{StaticResource TextSecondary}" FontFamily="Cairo" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,8,0,0">
                        <Border x:Name="EditSaveBtn" BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="0" HeightRequest="44">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEditSaveTapped" />
                            </Border.GestureRecognizers>
                            <Label x:Name="EditSaveLabel" Text="Change" TextColor="#050B14" FontFamily="Cairo" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="Transparent" Stroke="#FF4444" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="0" HeightRequest="44">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDeleteTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="Delete Data" TextColor="#FF4444" FontFamily="Cairo" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
