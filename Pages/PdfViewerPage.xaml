<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NMU_CE_App.Controls"
             x:Class="NMU_CE_App.Pages.PdfViewerPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BgMain}">

    <Grid>
        <GraphicsView x:Name="GridCanvas"
                      InputTransparent="True">
            <GraphicsView.Drawable>
                <controls:GridBackgroundDrawable />
            </GraphicsView.Drawable>
        </GraphicsView>

        <Grid RowDefinitions="Auto, *">
            <Grid Grid.Row="0"
                  BackgroundColor="{StaticResource HeaderBg}"
                  Padding="20,0"
                  ColumnDefinitions="Auto, *, Auto"
                  HeightRequest="58">
                <Border Grid.Column="0"
                        BackgroundColor="#0DFFFFFF"
                        Stroke="#1FFFFFFF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="4"
                        WidthRequest="34" HeightRequest="34"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="←"
                           FontSize="18"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>

                <Label x:Name="PageTitle"
                       Grid.Column="1"
                       Text="Viewer"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"
                       FontFamily="Cairo"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="*">
                <WebView x:Name="PdfViewer" Grid.Row="0" />

                <Border x:Name="DownloadBtn"
                        BackgroundColor="{StaticResource BgCard}"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 16"
                        WidthRequest="56" HeightRequest="56"
                        VerticalOptions="End" HorizontalOptions="End"
                        Margin="0,0,20,60">
                    <Border.Shadow>
                        <Shadow Brush="#4000F2FF" Offset="0,4" Radius="12" Opacity="0.5" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDownloadTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="⬇"
                           FontSize="26"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>

                <Grid x:Name="LoadingOverlay"
                      Grid.Row="0"
                      BackgroundColor="{StaticResource BgMain}"
                      IsVisible="True">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
                        <ActivityIndicator IsRunning="True"
                                           Color="{StaticResource Primary}"
                                           WidthRequest="50" HeightRequest="50" />
                        <Label Text="Loading PDF..."
                               FontSize="14"
                               TextColor="{StaticResource TextSecondary}"
                               FontFamily="Cairo"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
