<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NMU_CE_App.Controls"
             x:Class="NMU_CE_App.Pages.PdfViewerPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BgMain}">

    <Grid RowDefinitions="Auto, *">
        <GraphicsView x:Name="GridCanvas"
                      InputTransparent="True"
                      Grid.RowSpan="2">
            <GraphicsView.Drawable>
                <controls:GridBackgroundDrawable />
            </GraphicsView.Drawable>
        </GraphicsView>

        <controls:AITitleBar x:Name="PageTitleBar"
                             Grid.Row="0"
                             Title="{Binding Source={x:Reference PageTitle}, Path=Text}"
                             ShowBack="True"
                             BackClicked="OnTitleBarBack" />

        <Grid Grid.Row="1" RowDefinitions="*">
            <WebView x:Name="PdfViewer" Grid.Row="0" />

            <Border x:Name="DownloadBtn"
                    BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource AIPrimary}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 16"
                    WidthRequest="56" HeightRequest="56"
                    VerticalOptions="End" HorizontalOptions="End"
                    Margin="0,0,20,60">
                <Border.Shadow>
                    <Shadow Brush="#407C3AED" Offset="0,4" Radius="12" Opacity="0.5" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDownloadTapped" />
                </Border.GestureRecognizers>
                <Label Text="⬇"
                       FontSize="26"
                       TextColor="{StaticResource AIPrimary}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Border>

            <Grid x:Name="LoadingOverlay"
                  Grid.Row="0"
                  BackgroundColor="{StaticResource BgMain}"
                  IsVisible="True">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
                    <ActivityIndicator IsRunning="True"
                                       Color="{StaticResource AIPrimary}"
                                       WidthRequest="50" HeightRequest="50" />
                    <Label Text="Loading PDF..."
                           FontSize="14"
                           TextColor="{StaticResource TextSecondary}"
                           FontFamily="Cairo"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <Label x:Name="PageTitle" Text="Viewer" IsVisible="False" />
    </Grid>
</ContentPage>
