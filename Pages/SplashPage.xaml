<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NMU_CE_App.Controls"
             x:Class="NMU_CE_App.Pages.SplashPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <RadialGradientBrush Center="0.5,0.5" Radius="0.9">
            <GradientStop Color="#2A1055" Offset="0.0" />
            <GradientStop Color="#080B12" Offset="0.8" />
        </RadialGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *">

        <GraphicsView x:Name="GridCanvas"
                      Grid.RowSpan="2"
                      InputTransparent="True"
                      Opacity="0.7">
            <GraphicsView.Drawable>
                <controls:GridBackgroundDrawable />
            </GraphicsView.Drawable>
        </GraphicsView>

        <controls:AITitleBar x:Name="AppTitleBar"
                             Grid.Row="0"
                             Title="NMU-CE &amp; AIE"
                             ShowBack="False" />

        <ScrollView Grid.Row="1" VerticalOptions="Fill" HorizontalOptions="Fill">
            <Grid Padding="20" HorizontalOptions="Center" VerticalOptions="Center" MinimumHeightRequest="550">

                <Border x:Name="DialogCard"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        MaximumWidthRequest="450"
                        WidthRequest="{OnIdiom Phone='340', Tablet='420', Desktop='450'}"
                        Padding="{OnIdiom Phone='24,32', Desktop='32,40'}"
                        BackgroundColor="#111827" 
                        Stroke="#00E5FF" 
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 24"
                        Opacity="0"
                        Scale="0.95">

                    <Border.Shadow>
                        <Shadow Brush="#00E5FF" Offset="0,0" Radius="35" Opacity="0.3" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="24" HorizontalOptions="Fill">

                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="NMU-CE"
                                   FontSize="32"
                                   FontFamily="Cairo"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF"
                                   HorizontalTextAlignment="Center">
                                <Label.Shadow>
                                    <Shadow Brush="#00E5FF" Offset="0,0" Radius="10" Opacity="0.4" />
                                </Label.Shadow>
                            </Label>
                            <Label Text="AI-Powered Engineering Platform"
                                   FontSize="14"
                                   FontFamily="Cairo"
                                   TextColor="#00E5FF"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#1F2937" Margin="0,4" />

                        <VerticalStackLayout x:Name="SetupForm" Spacing="20" HorizontalOptions="Fill">

                            <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                                <Label Text="Full Name" TextColor="#D1D5DB" FontSize="13" FontFamily="Cairo" />
                                <Border BackgroundColor="#1F2937" Stroke="#374151" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="0" HorizontalOptions="Fill">
                                    <Entry x:Name="NameEntry" 
                                           Placeholder="e.g. Abdelrahman Elsayed" 
                                           PlaceholderColor="#6B7280" 
                                           TextColor="#FFFFFF" 
                                           FontSize="15" 
                                           FontFamily="Cairo" 
                                           BackgroundColor="Transparent"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Fill" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                                <Label Text="Select Academic Level" TextColor="#D1D5DB" FontSize="13" FontFamily="Cairo" />
                                <Border BackgroundColor="#1F2937" Stroke="#374151" StrokeThickness="1" StrokeShape="RoundRectangle 10" MinimumHeightRequest="50" Padding="0" HorizontalOptions="Fill">
                                    <Picker x:Name="YearPicker">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>Level 1</x:String>
                                                <x:String>Level 2</x:String>
                                                <x:String>Level 3</x:String>
                                                <x:String>Level 4</x:String>
                                                <x:String>Level 5</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                                <Label Text="Semester" TextColor="#D1D5DB" FontSize="13" FontFamily="Cairo" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" HorizontalOptions="Fill">
                                    <Border x:Name="Term1Btn" Grid.Column="0" BackgroundColor="#1F2937" Stroke="#374151" StrokeThickness="1" StrokeShape="RoundRectangle 10" HeightRequest="48">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTerm1Tapped" />
                                        </Border.GestureRecognizers>
                                        <Label x:Name="Term1Label" Text="Term 1" TextColor="#9CA3AF" FontFamily="Cairo" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <Border x:Name="Term2Btn" Grid.Column="1" BackgroundColor="#1F2937" Stroke="#374151" StrokeThickness="1" StrokeShape="RoundRectangle 10" HeightRequest="48">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTerm2Tapped" />
                                        </Border.GestureRecognizers>
                                        <Label x:Name="Term2Label" Text="Term 2" TextColor="#9CA3AF" FontFamily="Cairo" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>

                            <Border x:Name="SaveBtn" 
                                    BackgroundColor="#00E5FF" 
                                    StrokeThickness="0" 
                                    StrokeShape="RoundRectangle 10" 
                                    HeightRequest="52" 
                                    Margin="0,16,0,0"
                                    HorizontalOptions="Fill">
                                <Border.Shadow>
                                    <Shadow Brush="#00E5FF" Offset="0,0" Radius="15" Opacity="0.4" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSaveTapped" />
                                    <PointerGestureRecognizer PointerEntered="OnSaveBtnPointerEntered" 
                                                              PointerExited="OnSaveBtnPointerExited" />
                                </Border.GestureRecognizers>
                                <Label x:Name="SaveLabel" Text="Launch Platform" TextColor="#0B0F19" FontFamily="Cairo" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="LoadingSection" IsVisible="False" Spacing="16" Margin="0,20,0,0" HorizontalOptions="Center">
                            <ActivityIndicator IsRunning="True" Color="#00E5FF" WidthRequest="32" HeightRequest="32" />
                            <Label x:Name="LoadingLabel" Text="Loading workspace..." TextColor="#00E5FF" FontFamily="Cairo" FontSize="14" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>

        <Label x:Name="FooterLabel"
               Grid.Row="1"
               VerticalOptions="End"
               HorizontalOptions="Center"
               TextColor="#4B5563"
               FontSize="11"
               FontFamily="Cairo"
               Margin="0,0,0,16" />
    </Grid>
</ContentPage>