<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NMU_CE_App.Controls"
             x:Class="NMU_CE_App.Pages.SplashPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BgMain}">

    <Grid RowDefinitions="Auto, *">
        <GraphicsView x:Name="GridCanvas"
                      InputTransparent="True"
                      Grid.RowSpan="2">
            <GraphicsView.Drawable>
                <controls:GridBackgroundDrawable />
            </GraphicsView.Drawable>
        </GraphicsView>

        <controls:AITitleBar x:Name="AppTitleBar"
                             Grid.Row="0"
                             Title="NMU-CE &amp; AIE"
                             ShowBack="False" />

        <ScrollView Grid.Row="1"
                    Padding="20,20">
            <VerticalStackLayout x:Name="ContentRoot"
                                 MaximumWidthRequest="440"
                                 HorizontalOptions="Center"
                                 Spacing="0">

                <!-- Hero Section -->
                <VerticalStackLayout x:Name="HeroSection"
                                     Spacing="12"
                                     Margin="0,60,0,0"
                                     HorizontalOptions="Center">
                    <Border BackgroundColor="#1A7C3AED"
                            Stroke="#337C3AED"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 36"
                            WidthRequest="72" HeightRequest="72"
                            HorizontalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="#557C3AED" Offset="0,0" Radius="24" Opacity="0.6" />
                        </Border.Shadow>
                        <Label Text="🧠"
                               FontSize="32"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Border>

                    <Label x:Name="MainTitle"
                           Text="NMU-CE &amp; AIE"
                           FontSize="30"
                           TextColor="{StaticResource AICyan}"
                           FontAttributes="Bold"
                           FontFamily="Cairo"
                           HorizontalTextAlignment="Center" />

                    <Label Text="AI-POWERED ENGINEERING PLATFORM"
                           FontSize="13"
                           TextColor="{StaticResource TextMuted}"
                           FontFamily="Cairo"
                           HorizontalTextAlignment="Center" />

                    <BoxView HeightRequest="1"
                             Color="{StaticResource AIPrimary}"
                             Opacity="0.3"
                             Margin="40,8,40,0" />
                </VerticalStackLayout>

                <!-- Setup Form -->
                <VerticalStackLayout x:Name="SetupForm"
                                     Spacing="20"
                                     Margin="0,32,0,0">

                    <Label Text="Let's Get Started"
                           FontSize="22"
                           TextColor="{StaticResource TextPrimary}"
                           FontAttributes="Bold"
                           FontFamily="Cairo"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Enter your information to personalize your experience"
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}"
                           FontFamily="Cairo"
                           HorizontalTextAlignment="Center" />

                    <!-- Name Field -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Your Name"
                               TextColor="{StaticResource AICyan}"
                               FontSize="13"
                               FontAttributes="Bold"
                               FontFamily="Cairo" />
                        <Border BackgroundColor="{StaticResource InputBg}"
                                Stroke="{StaticResource BorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,0"
                                HeightRequest="50">
                            <Border.Shadow>
                                <Shadow Brush="#0D7C3AED" Offset="0,0" Radius="8" Opacity="0.3" />
                            </Border.Shadow>
                            <Entry x:Name="NameEntry"
                                   Placeholder="Enter your full name..."
                                   PlaceholderColor="{StaticResource TextMuted}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontFamily="Cairo"
                                   FontSize="15"
                                   BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Academic Level -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Academic Level"
                               TextColor="{StaticResource AICyan}"
                               FontSize="13"
                               FontAttributes="Bold"
                               FontFamily="Cairo" />
                        <Border BackgroundColor="{StaticResource InputBg}"
                                Stroke="{StaticResource BorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,0"
                                HeightRequest="50">
                            <Picker x:Name="YearPicker"
                                    TextColor="{StaticResource TextPrimary}"
                                    TitleColor="{StaticResource TextMuted}"
                                    FontFamily="Cairo"
                                    FontSize="15"
                                    BackgroundColor="Transparent"
                                    Title="Choose your level">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Level 1</x:String>
                                        <x:String>Level 2</x:String>
                                        <x:String>Level 3</x:String>
                                        <x:String>Level 4</x:String>
                                        <x:String>Level 5</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Semester Selector -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Semester"
                               TextColor="{StaticResource AICyan}"
                               FontSize="13"
                               FontAttributes="Bold"
                               FontFamily="Cairo" />
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <Border x:Name="Term1Tile"
                                    Stroke="{StaticResource BorderColor}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="16"
                                    BackgroundColor="{StaticResource InputBg}"
                                    HeightRequest="52">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTerm1Tapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="Term1Label"
                                       Text="Semester 1"
                                       TextColor="{StaticResource TextSecondary}"
                                       FontFamily="Cairo"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>

                            <Border Grid.Column="1"
                                    x:Name="Term2Tile"
                                    Stroke="{StaticResource BorderColor}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="16"
                                    BackgroundColor="{StaticResource InputBg}"
                                    HeightRequest="52">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTerm2Tapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="Term2Label"
                                       Text="Semester 2"
                                       TextColor="{StaticResource TextSecondary}"
                                       FontFamily="Cairo"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Save Button -->
                    <Border x:Name="SaveBtn"
                            BackgroundColor="{StaticResource AIPrimary}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            HeightRequest="52"
                            Margin="0,8,0,0">
                        <Border.Shadow>
                            <Shadow Brush="#557C3AED" Offset="0,4" Radius="16" Opacity="0.5" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSaveTapped" />
                        </Border.GestureRecognizers>
                        <Label x:Name="SaveLabel"
                               Text="🚀 Launch Platform"
                               TextColor="White"
                               FontFamily="Cairo"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Border>

                </VerticalStackLayout>

                <!-- Loading Indicator -->
                <VerticalStackLayout x:Name="LoadingSection"
                                     IsVisible="False"
                                     Spacing="16"
                                     Margin="0,40,0,0"
                                     HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="True"
                                       Color="{StaticResource AIPrimary}"
                                       WidthRequest="40"
                                       HeightRequest="40" />
                    <Label x:Name="LoadingLabel"
                           Text="Preparing your experience..."
                           TextColor="{StaticResource TextSecondary}"
                           FontFamily="Cairo"
                           FontSize="14"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Spacer -->
                <BoxView HeightRequest="40" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer -->
        <Label x:Name="FooterLabel"
               VerticalOptions="End"
               HorizontalOptions="Center"
               TextColor="{StaticResource TextMuted}"
               FontSize="11"
               FontFamily="Cairo"
               Margin="0,0,0,12" />
    </Grid>
</ContentPage>
