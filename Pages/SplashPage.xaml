<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NMU_CE_App.Pages.SplashPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#050B14">

    <Grid RowDefinitions="Auto, *" Padding="25">
        <Label Grid.Row="0" Text="NMU-CE &amp; AIE"
               TextColor="#00F2FF" FontSize="20"
               FontAttributes="Bold" FontFamily="Cairo"
               Margin="0,50,0,0" />

        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="20">
            <Label Text="NMU-CE &amp; AIE"
                   TextColor="White" FontSize="28"
                   FontAttributes="Bold" FontFamily="Cairo"
                   HorizontalTextAlignment="Center" />

            <Label Text="Preparing your workspace..."
                   TextColor="#94A3B8" FontSize="16"
                   FontFamily="Cairo" HorizontalTextAlignment="Center" />

            <Grid x:Name="SetupOverlay" IsVisible="False">
                <Border BackgroundColor="#1A0F172A" Stroke="#00F2FF"
                        StrokeThickness="1" StrokeShape="RoundRectangle 20"
                        Padding="30" WidthRequest="440"
                        HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="22">
                        <Label Text="THE INFORMATION" TextColor="#00F2FF"
                               FontSize="20" FontAttributes="Bold"
                               FontFamily="Cairo" HorizontalTextAlignment="Center" />

                        <VerticalStackLayout Spacing="10">
                            <Label Text="Your Name" TextColor="#94A3B8"
                                   FontSize="13" FontFamily="Cairo" />
                            <Border BackgroundColor="#0D0F172A" Stroke="#334155"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="13,0">
                                <Entry x:Name="NameEntry" Placeholder="Enter Your Name Here..."
                                       PlaceholderColor="#64748B" TextColor="White"
                                       FontFamily="Cairo" FontSize="15"
                                       BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10">
                            <Label Text="Academic Level" TextColor="#94A3B8"
                                   FontSize="13" FontFamily="Cairo" />
                            <Border BackgroundColor="#0D0F172A" Stroke="#334155"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="13,0">
                                <Picker x:Name="YearPicker" TextColor="White"
                                        FontFamily="Cairo" FontSize="15"
                                        BackgroundColor="Transparent" Title="Select Level">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Level 1</x:String>
                                            <x:String>Level 2</x:String>
                                            <x:String>Level 3</x:String>
                                            <x:String>Level 4</x:String>
                                            <x:String>Level 5</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10">
                            <Label Text="Select The Semester" TextColor="#94A3B8"
                                   FontSize="13" FontFamily="Cairo" />
                            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                                <Border x:Name="Term1Tile" Stroke="#334155"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 12"
                                        Padding="14" BackgroundColor="#0D0F172A" WidthRequest="140">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTerm1Tapped" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="Term1Label" Text="Semester 1"
                                           TextColor="#94A3B8" FontFamily="Cairo"
                                           FontSize="15" FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" />
                                </Border>
                                <Border x:Name="Term2Tile" Stroke="#334155"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 12"
                                        Padding="14" BackgroundColor="#0D0F172A" WidthRequest="140">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTerm2Tapped" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="Term2Label" Text="Semester 2"
                                           TextColor="#94A3B8" FontFamily="Cairo"
                                           FontSize="15" FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" />
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <Border BackgroundColor="#00F2FF" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12" Padding="0" HeightRequest="50"
                                Margin="0,15,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSaveTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="Save Data" TextColor="#050B14"
                                   FontFamily="Cairo" FontSize="16" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>

        <Label Grid.Row="2" x:Name="FooterLabel"
               Text="Powered By ABDELRHMAN ELSAYED © 2026"
               TextColor="#64748B" FontSize="12" FontFamily="Cairo"
               HorizontalTextAlignment="Center" Margin="0,0,0,10" />
    </Grid>

</ContentPage>
