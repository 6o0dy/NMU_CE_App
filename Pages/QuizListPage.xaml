<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NMU_CE_App.Controls"
             x:Class="NMU_CE_App.Pages.QuizListPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BgMain}">

    <Grid RowDefinitions="Auto, *">
        <GraphicsView x:Name="GridCanvas" InputTransparent="True" Grid.RowSpan="2">
            <GraphicsView.Drawable>
                <controls:GridBackgroundDrawable />
            </GraphicsView.Drawable>
        </GraphicsView>

        <controls:AITitleBar x:Name="PageTitleBar"
                             Grid.Row="0"
                             Title="University Quiz Pro"
                             ShowBack="True"
                             BackClicked="OnTitleBarBack" />

        <ScrollView Grid.Row="1" Padding="20,10">
            <VerticalStackLayout Spacing="15">
                <Label x:Name="StatusLabel"
                       Text="Loading quizzes..."
                       TextColor="{StaticResource TextSecondary}"
                       FontSize="16"
                       FontFamily="Cairo"
                       HorizontalTextAlignment="Center"
                       Margin="0,30,0,0" />

                <FlexLayout x:Name="SubjectsGrid"
                            Wrap="Wrap"
                            JustifyContent="Center"
                            AlignItems="Start"
                            AlignContent="Start"
                            IsVisible="False" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
