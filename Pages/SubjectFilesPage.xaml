<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NMU_CE_App.Controls"
             x:Class="NMU_CE_App.Pages.SubjectFilesPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource BgMain}">

    <Grid>
        <GraphicsView x:Name="GridCanvas"
                      InputTransparent="True">
            <GraphicsView.Drawable>
                <controls:GridBackgroundDrawable />
            </GraphicsView.Drawable>
        </GraphicsView>

        <Grid RowDefinitions="Auto, *">
            <controls:AITitleBar x:Name="PageTitleBar"
                                 Title="{Binding Source={x:Reference PageTitle}, Path=Text}"
                                 ShowBack="True"
                                 BackClicked="OnTitleBarBack" />

            <Grid Grid.Row="1"
                  RowDefinitions="Auto, *, Auto">

                <Border Grid.Row="0"
                        BackgroundColor="{StaticResource InputBg}"
                        Stroke="#334155"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="0"
                        Margin="8,10,8,5"
                        HeightRequest="40">
                    <Entry x:Name="SearchEntry"
                           Placeholder="Search files..."
                           PlaceholderColor="{StaticResource TextSecondary}"
                           TextColor="White"
                           FontFamily="Cairo"
                           FontSize="14"
                           BackgroundColor="Transparent"
                           HorizontalTextAlignment="Center"
                           TextChanged="OnSearchTextChanged" />
                </Border>

                <ScrollView Grid.Row="1" Padding="0">
                    <VerticalStackLayout x:Name="FilesList"
                                         HorizontalOptions="Fill"
                                         Spacing="14" />
                </ScrollView>

                <HorizontalStackLayout x:Name="FolderTabs"
                                       Grid.Row="2"
                                       BackgroundColor="{StaticResource HeaderBg}"
                                       Padding="5"
                                       HorizontalOptions="Center"
                                       Spacing="0" />
            </Grid>
        </Grid>

        <!-- Hidden label for binding title -->
        <Label x:Name="PageTitle" Text="Loading..." IsVisible="False" />
    </Grid>
</ContentPage>
